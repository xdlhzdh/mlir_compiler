# run_lowering.cmake — Run P4 (ONNX → StableHLO lowering, tiers 1–3)
# Variables: RUN_L1, RUN_L2, RUN_L3 (executables for tier 1/2/3), MODEL_DIR

macro(banner title)
  message(STATUS "")
  message(STATUS "======================================")
  message(STATUS "  ${title}")
  message(STATUS "======================================")
endmacro()

macro(run_exe exe model)
  execute_process(COMMAND ${exe} ${model} RESULT_VARIABLE rv)
  if(rv)
    message(FATAL_ERROR "${exe} failed on ${model} (exit ${rv})")
  endif()
endmacro()

# ── P4 tier 1: basic lowering ──
banner("P4 tier 1: Basic — lowering_basic.onnx (Add + MatMul)")
run_exe(${RUN_L1} "${MODEL_DIR}/lowering_basic.onnx")

banner("Level 1: Basic — lowering_conv.onnx (Conv)")
run_exe(${RUN_L1} "${MODEL_DIR}/lowering_conv.onnx")

banner("P4 tier 1: Basic — lowering_reshape_transpose.onnx (Reshape + Transpose)")
run_exe(${RUN_L1} "${MODEL_DIR}/lowering_reshape_transpose.onnx")

# ── P4 tier 2: enhanced lowering ──
banner("P4 tier 2: Enhanced — lowering_broadcast.onnx (broadcast Add/Mul)")
run_exe(${RUN_L2} "${MODEL_DIR}/lowering_broadcast.onnx")

banner("P4 tier 2: Enhanced — lowering_conv_full.onnx (Conv + bias + strides + pads)")
run_exe(${RUN_L2} "${MODEL_DIR}/lowering_conv_full.onnx")

banner("P4 tier 2: Enhanced — lowering_dynamic.onnx (dynamic batch)")
run_exe(${RUN_L2} "${MODEL_DIR}/lowering_dynamic.onnx")

banner("P4 tier 2: Enhanced — lowering_dynamic_mn.onnx (dynamic M/N MatMul)")
run_exe(${RUN_L2} "${MODEL_DIR}/lowering_dynamic_mn.onnx")

banner("P4 tier 2: Enhanced — lowering_matmul_f16.onnx (FP16 MatMul)")
run_exe(${RUN_L2} "${MODEL_DIR}/lowering_matmul_f16.onnx")

# ── P4 tier 3: conversion framework ──
banner("P4 tier 3: Framework — lowering_basic.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_basic.onnx")

banner("P4 tier 3: Framework — lowering_broadcast.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_broadcast.onnx")

banner("P4 tier 3: Framework — lowering_conv_full.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_conv_full.onnx")

banner("P4 tier 3: Framework — lowering_softmax.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_softmax.onnx")

banner("P4 tier 3: Framework — lowering_attention.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_attention.onnx")

banner("P4 tier 3: Framework — lowering_decode_step.onnx (seq=1 KV decode)")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_decode_step.onnx")

banner("P4 tier 3: Framework — lowering_rmsnorm.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_rmsnorm.onnx")

banner("P4 tier 3: Framework — lowering_layernorm.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_layernorm.onnx")

banner("P4 tier 3: Framework — lowering_rope.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_rope.onnx")

banner("P4 tier 3: Framework — lowering_gelu.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_gelu.onnx")

banner("P4 tier 3: Framework — lowering_swiglu.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_swiglu.onnx")

banner("P4 tier 3: Framework — lowering_matmul_bias.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_matmul_bias.onnx")

banner("P4 tier 3: Framework — lowering_matmul_f16.onnx (FP16 MatMul)")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_matmul_f16.onnx")

banner("P4 tier 3: Framework — lowering_dynamic_mn.onnx (dynamic M/N MatMul)")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_dynamic_mn.onnx")

banner("P4 tier 3: Framework — lowering_layout_conv.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_layout_conv.onnx")

banner("P4 tier 3: Framework — lowering_qdq_matmul.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_qdq_matmul.onnx")

banner("P4 tier 3: Framework — lowering_horizontal_gemm.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_horizontal_gemm.onnx")

banner("P4 tier 3: Framework — lowering_transformer_block.onnx")
run_exe(${RUN_L3} "${MODEL_DIR}/lowering_transformer_block.onnx")

banner("P4 tier 3: Framework — quant_qdq_matmul.onnx (P11 Q/DQ)")
run_exe(${RUN_L3} "${QUANT_MODEL_DIR}/quant_qdq_matmul.onnx")

message(STATUS "")
message(STATUS "All P4 lowering tiers (1–3) completed successfully.")
